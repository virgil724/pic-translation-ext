{
  "manifest_version": 3,
  "name": "畫面翻譯（Gemini）",
  "version": "0.0.1",
  "description": "擷取目前分頁的可見畫面，用 Gemini 翻譯成台灣繁體中文並疊回原文位置。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://aiplatform.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "翻譯目前畫面",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "翻譯目前畫面"
    },
    "toggle-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "顯示／隱藏譯文"
    },
    "clear-overlay": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "清除譯文"
    }
  }
}
